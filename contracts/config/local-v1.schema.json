{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slurm Notify local configuration v1",
  "description": "Structural schema for webhook/Slack/required-STARTTLS SMTP configs. Rust additionally enforces strict lexemes/duplicates, byte/depth budgets, relationships, references, protected resources and exact permissions.",
  "type": "object",
  "required": [
    "schema_version",
    "monitor",
    "storage",
    "providers",
    "routes",
    "delivery",
    "maintenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "monitor": {
      "type": "object",
      "required": [
        "mode",
        "cluster_id",
        "user_jobs_only",
        "initial_observation",
        "poll_seconds",
        "query_timeout_seconds",
        "accounting_lookback_seconds",
        "accounting_overlap_seconds",
        "command_output_limit_bytes",
        "retained_identity_limit",
        "retained_event_limit",
        "stale_after_seconds"
      ],
      "properties": {
        "mode": {
          "const": "local"
        },
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "user_jobs_only": {
          "const": true
        },
        "initial_observation": {
          "enum": [
            "suppress",
            "emit"
          ]
        },
        "poll_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "query_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "accounting_lookback_seconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 604800
        },
        "accounting_overlap_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "command_output_limit_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "retained_identity_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "retained_event_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "url_env",
              "request_timeout_seconds",
              "payload_limit_bytes"
            ],
            "properties": {
              "type": {
                "enum": ["webhook", "slack"]
              },
              "url_env": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "request_timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "payload_limit_bytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 16384
              },
              "authorization_env": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "trust_der_files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "relay",
              "port",
              "tls_mode",
              "server_name",
              "trust_der_files",
              "authentication",
              "sender",
              "recipient",
              "visibility",
              "identity_namespace",
              "request_timeout_milliseconds"
            ],
            "properties": {
              "type": {
                "const": "smtp"
              },
              "relay": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9.:-]+$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "tls_mode": {
                "const": "required_starttls"
              },
              "server_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9.:-]+$"
              },
              "trust_der_files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                }
              },
              "authentication": {
                "type": "object",
                "required": [
                  "identity",
                  "username_env",
                  "password_env"
                ],
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[ -~]+$"
                  },
                  "username_env": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "password_env": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "additionalProperties": false
              },
              "sender": {
                "type": "string",
                "minLength": 1,
                "maxLength": 254,
                "pattern": "^[!-~]+$"
              },
              "recipient": {
                "type": "string",
                "minLength": 1,
                "maxLength": 254,
                "pattern": "^[!-~]+$"
              },
              "visibility": {
                "enum": [
                  "hidden",
                  "included"
                ]
              },
              "identity_namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "request_timeout_milliseconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30000
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "routes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "events",
          "send_to"
        ],
        "properties": {
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 9,
            "uniqueItems": true,
            "items": {
              "enum": [
                "JOB_STARTED",
                "JOB_COMPLETED",
                "JOB_FAILED",
                "JOB_TIMEOUT",
                "JOB_CANCELLED",
                "JOB_OUT_OF_MEMORY",
                "JOB_NODE_FAILURE",
                "JOB_BOOT_FAILURE",
                "JOB_DEADLINE"
              ]
            }
          },
          "send_to": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "max_attempts",
        "initial_backoff_seconds",
        "max_backoff_seconds",
        "jitter_seconds",
        "batch_limit",
        "jitter_seed"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "initial_backoff_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_backoff_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "jitter_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "batch_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "jitter_seed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "prepared_smtp_message_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "smtp_permissions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "cluster_id",
              "destination",
              "rendering_revision",
              "provider_revision"
            ],
            "properties": {
              "cluster_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "rendering_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "provider_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "required": [
        "completed_delivery_retention_seconds",
        "cleanup_batch_limit",
        "health_sample_limit",
        "smtp_revision_cleanup_limit"
      ],
      "properties": {
        "completed_delivery_retention_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "cleanup_batch_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "health_sample_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "smtp_revision_cleanup_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "providers": {
            "not": {
              "additionalProperties": {
                "type": "object",
                "required": [
                  "type",
                  "url_env",
                  "request_timeout_seconds",
                  "payload_limit_bytes"
                ],
                "properties": {
                  "type": {
                    "enum": ["webhook", "slack"]
                  },
                  "url_env": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "request_timeout_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "payload_limit_bytes": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 16384
                  },
                  "authorization_env": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "trust_der_files": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "required": [
              "prepared_smtp_message_limit",
              "smtp_permissions"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "delivery": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "prepared_smtp_message_limit"
                  ]
                },
                {
                  "required": [
                    "smtp_permissions"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
